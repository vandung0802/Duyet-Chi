      "assets": {
        // v40 (24/09/2026): VẬT TƯ / THIẾT BỊ LUÂN CHUYỂN — sổ theo dõi đơn vị nào chuyển gì đến công trường để còn thu hồi.
        // Không phải tiền. Ai đã duyệt cũng đọc / ghi / sửa / thu hồi; XOÁ chỉ Dũng, Toàn, phụ trách vật tư (trang) hoặc chính người ghi.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || data.child('by').val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'qty', 'from', 'by', 'ts'])",
          "by":       { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid)" },
          "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "qty":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000" },
          "unit":     { ".validate": "!newData.isString() || newData.val().length <= 30" },
          "from":     { ".validate": "newData.val() === 'pva' || newData.val() === '134' || newData.val() === 'other'" },
          "fromName": { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "date":     { ".validate": "!newData.isString() || newData.val().length <= 10" },
          "note":     { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          "byName":   { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "ts":       { ".validate": "newData.isNumber()" },
          "returned": {
            "$i": {
              "qty":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "date": { ".validate": "!newData.isString() || newData.val().length <= 10" },
              "ts":   { ".validate": "newData.isNumber()" },
              "by":   { ".validate": "!newData.isString() || newData.val().length <= 200" },
              "$o":   { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },

      "employees": {
        // v85: DANH SÁCH NHÂN VIÊN hưởng lương (module Lương, TÁCH BIỆT). Ai đã duyệt cũng đọc/ghi
        // (thêm/sửa nhân viên) — giống persons nhưng riêng cho lương. Không đụng proposals/plans.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
          "name":  { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "group": { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "note":  { ".validate": "!newData.isString() || newData.val().length <= 2000" }
        }
      },

      "salaryAdvances": {
        // v85: ĐỀ XUẤT ỨNG LƯƠNG (module Lương). Bảo mật mô phỏng proposals nhưng đơn giá 1 giá trị:
        // ai đã duyệt cũng ĐỀ XUẤT được; số D duyệt CHỈ Dũng, số H duyệt CHỈ Hiền, số chuyển CHỈ Trang;
        // nội dung (nhân viên/tháng/số đề xuất) ĐÓNG BĂNG sau khi có duyệt. Hoàn toàn tách proposals.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // Tạo/sửa: phải ĐÃ DUYỆT; XÓA phiếu đã có duyệt/chuyển → chỉ Dũng; chưa có gì → ai đã duyệt.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !(data.child('approvedD').exists() || data.child('approvedH').exists() || data.child('transferred').exists()))",
          // ĐÓNG BĂNG nội dung sau khi có bất kỳ dấu duyệt nào (D hoặc H)
          "amount":  { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "empId":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "empName": { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "group":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "month":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 20)" },
          "note":    { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          // SỐ DUYỆT / CHUYỂN: chỉ đúng vai trò được đặt/đổi; giữ nguyên thì ai ghi cũng qua (app ghi lại cả phiếu)
          "approvedD":   { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "approvedH":   { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "transferred": { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          // TRẠNG THÁI: đặt lần đầu ai cũng được; đổi về sau chỉ D/H/T
          "status": { ".validate": "!data.exists() || newData.val() === data.val() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan'" }
        }
      },

      "groupChat": {
        // v113 CHAT NHÓM CÔNG TY: chỉ tài khoản ĐÃ DUYỆT đọc/gửi. Tin CHỈ THÊM MỚI hoặc XÓA
        // (không sửa): DŨNG xóa được mọi tin (kể cả xóa sạch cả nhóm — .write cấp cha);
        // người khác chỉ xóa tin CHÍNH MÌNH (so uid). User chốt 01/08.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$id": {
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (!data.exists() || (!newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('ts').isNumber() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 2000))"
        }
      },
      "chatPin": {
        // v116: TIN GHIM của nhóm chat (1 tin) — thành viên đã duyệt ghim/bỏ ghim
