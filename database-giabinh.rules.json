          "chat": { "$i": { ".validate": "(data.exists() && newData.child('text').val() === data.child('text').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && newData.child('text').isString() && newData.child('text').val().length <= 2000)" } },
          // Dấu ĐÃ XEM hỏi–đáp của từng người (đồng bộ đa thiết bị): chỉ là mốc thời gian
