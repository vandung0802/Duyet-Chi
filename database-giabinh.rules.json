{
  // ══ LUẬT BẢO MẬT — App SỔ QUỸ GIA BÌNH (project so-quy-gia-binh) ══
  // Bê nguyên từ app 379 để không sót lỗ hổng nào đã vá. Khác 379 ở chỗ:
  //  - ĐỘI ĐỎ 22/09/2026: ĐÃ GỠ email Hiền/Trang khỏi mọi luật. Ở project này 2 email đó CHƯA đăng ký
  //    (Firebase không bắt chứng minh sở hữu hộp thư) → người lạ đăng ký trước là tự có vai 'hien'/'trang',
  //    đọc hết sổ và giả được duyệt bước 2. Nay CHỈ email Dũng (chắc chắn đã đăng ký) là lối vào dự phòng;
  //    mọi người khác — kể cả Hiền, Trang — phải được Dũng bấm 'Cho xem' + cấp vai trong Cài đặt.
  //  - Lan (đại diện cty 134) duyệt NGANG Hiền → dùng chung vai 'hien'. Email Lan CHƯA có,
  //    nên Lan KHÔNG được ghi sẵn vào đây; D vào app cấp vai 'hien' cho Lan là chạy
  //    (3 email ghi cứng bên dưới chỉ là lối vào dự phòng lúc app chưa có ai duyệt tài khoản).
  //  - TẤT CẢ người đã duyệt đều xem được mọi phiếu (D chốt: ai có trong app là thấy hết).
  //  - Phần P.Kế hoạch (khProposals/khImages…) giữ lại để file không lệch với 379,
  //    nhưng app Gia Bình tắt tab đó nên không ai ghi vào.
  "rules": {

    "duyetchi": {
      // v79 BẢO MẬT: KHÔNG đặt ".read" ở cấp cha này. Trong Firebase RTDB, ".read" ở cha LAN XUỐNG mọi
      // con và con KHÔNG thu hồi được — nếu để ".read: auth != null" ở đây thì pendingOtp (mã OTP) sẽ bị
      // MỌI tài khoản đọc được, vô hiệu hoá luật đọc-hạn-chế của nó. Vì vậy quyền đọc được khai riêng ở
      // TỪNG nhánh con bên dưới (proposals/images/plans/meta/userRoles/online đều cho người đăng nhập đọc;
      // riêng pendingOtp chỉ chính chủ hoặc Dũng đọc).

      "userRoles": {
        // v81: Dũng đọc được CẢ node (để hiện danh sách "duyệt tài khoản"). Người khác chỉ đọc bản thân (ở $uid).
        ".read": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$uid": {
          ".read": "auth != null",
          // CHẶN LEO QUYỀN (v77): tự ghi role của MÌNH chỉ được 'other' — TRỪ 3 người nhà xác thực
          // bằng ĐÚNG EMAIL đăng nhập (không thể giả). Dũng ghi được cho bất kỳ ai.
          // v81/v82: TỰ ghi được hồ sơ của mình (tên/email/lastLogin) nhưng KHÔNG được TỰ ĐỔI cờ approved
          // (phải giữ nguyên như cũ) — chống tự cấp quyền xem. Chỉ Dũng mới đặt/đổi approved.
          // v125 P.KH: trường dept (phòng: ketoan/kehoach/both) cũng KHÓA như approved — chỉ Dũng đổi được,
          // chống người P.Kế hoạch tự đổi mình thành Kế toán để vượt rào đọc dữ liệu (bước 5).
          ".write": "auth != null && ((auth.uid === $uid && newData.child('approved').val() === data.child('approved').val() && newData.child('dept').val() === data.child('dept').val() && (newData.child('role').val() === 'other' || (newData.child('role').val() === 'dung' && auth.token.email === 'vandung0802@gmail.com') || (data.exists() && newData.child('role').val() === data.child('role').val()))) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          // ── ĐỘI ĐỎ 22/09/2026: DANH SÁCH TRẮNG + GIỚI HẠN CỠ cho hồ sơ ──
          // Trước đây hồ sơ (do chính người dùng ghi) không giới hạn gì: người lạ tự đăng ký nhồi được hàng trăm MB
          // → làm treo trang "Duyệt tài khoản" của Dũng, đốt băng thông. Đúng 6 trường app thật sự ghi:
          "role":      { ".validate": "newData.isString() && newData.val().length <= 20" },
          "name":      { ".validate": "newData.isString() && newData.val().length <= 200" },
          // email trong hồ sơ PHẢI đúng là email đăng nhập thật (Google xác thực). Trước đây tự ghi tuỳ ý →
          // người lạ ghi email của 1 nhân viên quen để danh sách duyệt KHÔNG báo đỏ "email lạ", lừa Dũng bấm duyệt.
          "email":     { ".validate": "newData.isString() && newData.val().length <= 320 && (newData.val() === auth.token.email || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" },
          "lastLogin": { ".validate": "newData.isNumber()" },
          "approved":  { ".validate": "newData.isBoolean()" },
          "dept":      { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other":    { ".validate": false }
        }
      },

      "meta": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT (approved) hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        // Chỉ Dũng mới sửa được danh sách người/công trình
        ".write": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'"
      },

      "proposals": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được (chống người lạ tự đăng ký xem).
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // Tạo/sửa: phải là tài khoản ĐÃ DUYỆT (v83 — tài khoản lạ/đã thu hồi không tạo/sửa phiếu được);
          // chi tiết bị siết thêm bằng validate từng trường bên dưới.
          // XÓA CẢ PHIẾU (newData không tồn tại): phiếu ĐÃ có duyệt → chỉ Dũng; phiếu chưa duyệt → tài khoản đã duyệt.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !(data.child('approvedD').exists() || data.child('approvedH').exists() || data.child('approvedDHistory').exists() || data.child('approvedHHistory').exists()))",

          // CHẶN GỠ DẤU DUYỆT / GỠ LỊCH SỬ (duyệt+chuyển) / GỠ ẢNH NỘI DUNG (v77 + v80):
          // - gỡ approvedD chỉ Dũng; gỡ approvedH chỉ Hiền (bỏ duyệt hợp lệ) — kẻ khác không thể "tự bỏ duyệt để mở khóa sửa"
          // - gỡ cả node transfers chỉ Trang; gỡ approvedDHistory chỉ Dũng, approvedHHistory chỉ Hiền (v80 —
          //   chống xóa/null lịch sử rồi lợi dụng approvedDAmount phụ để "backfill" số tiền giả)
          // - gỡ contentSnapshot (ảnh nội dung lúc duyệt) chỉ Dũng/Hiền
          ".validate": "(newData.child('approvedD').exists() || !data.child('approvedD').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedH').exists() || !data.child('approvedH').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('transfers').exists() || !data.child('transfers').exists() || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')) && (newData.child('approvedDHistory').exists() || !data.child('approvedDHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedHHistory').exists() || !data.child('approvedHHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('contentSnapshot').exists() || !data.child('contentSnapshot').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien')",

          // ĐÓNG BĂNG NỘI DUNG sau khi D HOẶC H đã duyệt (v77 — chống sửa số tài khoản/số tiền sau duyệt):
          // các trường dưới đây chỉ được GIỮ NGUYÊN một khi phiếu đã có bất kỳ dấu duyệt nào.
          // Muốn sửa thật: D/H bỏ duyệt trước (được phép theo luật trên) → sửa → duyệt lại.
          // v84: mỗi trường = (ĐÓNG BĂNG sau duyệt như cũ) && (GIỚI HẠN kích thước — chống tài khoản bị chiếm
          //      nhồi chữ rác / số tiền phi lý). Ngưỡng đặt RẤT RỘNG so với dữ liệu thật (desc dài nhất 158,
          //      note 179, amount lớn nhất ~859tr) nên KHÔNG thể chặn nhầm phiếu hợp lệ. Cap chỉ "cắn" đúng
          //      kiểu (isString/isNumber) — nếu không đúng kiểu thì không chặn (để lớp đóng băng lo).
          "desc":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          "note":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          // v95: lý do GẤP — trường tự do (không đóng băng), chỉ giới hạn độ dài chống nhồi rác
          "urgentReason": { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          "amount":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "amountUnit": { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 40)" },
          "person":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "site":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          // Gia Bình: LOẠI CHI PHÍ cũng đóng băng sau duyệt — đổi ký quỹ ↔ chi phí lúc đã duyệt/chuyển sẽ làm lệch sổ quỹ
          "costType":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 20)" },

          // DẤU DUYỆT: thêm/đổi approvedD chỉ Dũng, approvedH chỉ Hiền (giữ nguyên thì ai ghi cũng được —
          // cần thiết vì app luôn ghi CẢ phiếu mỗi lần có gì đổi, các trường không đổi phải đi qua được)
          "approvedD": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedH": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // BẢN LƯU PHỤ số tiền duyệt (approvedDAmount/HAmount): đổi giá trị chỉ Dũng/Hiền (v80).
          // Trước đây 2 trường này KHÔNG bị khóa → kẻ xấu đặt số giả rồi để máy D/H "backfill" thành lịch sử.
          "approvedDAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedHAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // LỊCH SỬ DUYỆT (nguồn chuẩn số tiền): từng lần duyệt BẤT BIẾN sau khi ghi; THÊM lần mới chỉ đúng người
          "approvedDHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" } },
          "approvedHHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien')" } },

          // LỊCH SỬ CHUYỂN TIỀN: từng lần chuyển bất biến; thêm lần mới chỉ THỦ QUỸ và CHỈ KHI đã có
          // bước duyệt 2 (Hiền/Lan) — quy trình Gia Bình: Dũng → Hiền/Lan → Toàn, không chuyển tắt.
          "transfers": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') && newData.parent().parent().child('approvedHHistory').exists())" } },

          // TRẠNG THÁI: đặt lần đầu (tạo phiếu) ai cũng được; ĐỔI về sau chỉ Dũng/Hiền/Trang (chặn vai trò 'other' giả mạo "đã chuyển")
          "status": { ".validate": "!data.exists() || newData.val() === data.val() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')" },

          // ẢNH NỘI DUNG LÚC DUYỆT (contentSnapshot — lớp phát hiện): từng trường chỉ Dũng/Hiền ghi/đổi
          "contentSnapshot": { "$f": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" } },

          // v106 HỎI–ĐÁP trên phiếu: từng câu nhắn BẤT BIẾN sau khi gửi (không sửa/xoá — user chốt);
          // thêm câu mới: bất kỳ tài khoản đã duyệt (đã gác ở .write), text ≤ 2000 ký tự.
          "chat": { "$i": { ".validate": "(data.exists() && newData.child('text').val() === data.child('text').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && newData.child('text').isString() && newData.child('text').val().length <= 2000)" } },
          // Dấu ĐÃ XEM hỏi–đáp của từng người (đồng bộ đa thiết bị): chỉ là mốc thời gian
          "chatSeen": { "$u": { ".validate": "newData.isNumber()" } }
        }
      },

      "images": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // v83: GHI cũng phải là tài khoản ĐÃ DUYỆT (tài khoản lạ / đã bị thu hồi không ghi/xoá ảnh được).
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')"
        }
      },

      // ══ bankBalance — số dư ngân hàng THẬT do thủ quỹ nhập để đối chiếu với sổ quỹ ══
      // Để riêng (không nằm trong meta) vì meta chỉ Dũng ghi được, mà người nhập số này là thủ quỹ.
      "bankBalance": {
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        ".validate": "!newData.exists() || (newData.child('amount').isNumber() && newData.child('amount').val() >= 0)"
      },

      // ══ cashflow — THU + KÝ QUỸ của Gia Bình (app 379 không có nhánh này) ══
      // Ai đã được duyệt đều GHI/SỬA được (sổ quỹ chung, không có luồng duyệt nhiều bước).
      // XÓA thì chỉ Dũng hoặc chính người đã ghi khoản đó — tiền chung 2 công ty, không để ai cũng xóa được.
      "cashflow": {
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // KHÔNG đặt .validate ở đây: ghi cọc lấy về chỉ đụng $id/returned (không có
          // type/amount) — validate của cha vẫn chạy khi ghi con nên sẽ chặn nhầm.
          // Quyền đã được .write gác đủ rồi.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || data.child('by').val() === auth.uid)"
        }
      },

      "plans": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // v83: GHI cũng phải là tài khoản ĐÃ DUYỆT.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')"
        }
      },

      "employees": {
        // v85: DANH SÁCH NHÂN VIÊN hưởng lương (module Lương, TÁCH BIỆT). Ai đã duyệt cũng đọc/ghi
        // (thêm/sửa nhân viên) — giống persons nhưng riêng cho lương. Không đụng proposals/plans.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
          "name":  { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "group": { ".validate": "!newData.isString() || newData.val().length <= 200" },
          "note":  { ".validate": "!newData.isString() || newData.val().length <= 2000" }
        }
      },

      "salaryAdvances": {
        // v85: ĐỀ XUẤT ỨNG LƯƠNG (module Lương). Bảo mật mô phỏng proposals nhưng đơn giá 1 giá trị:
        // ai đã duyệt cũng ĐỀ XUẤT được; số D duyệt CHỈ Dũng, số H duyệt CHỈ Hiền, số chuyển CHỈ Trang;
        // nội dung (nhân viên/tháng/số đề xuất) ĐÓNG BĂNG sau khi có duyệt. Hoàn toàn tách proposals.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // Tạo/sửa: phải ĐÃ DUYỆT; XÓA phiếu đã có duyệt/chuyển → chỉ Dũng; chưa có gì → ai đã duyệt.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !(data.child('approvedD').exists() || data.child('approvedH').exists() || data.child('transferred').exists()))",
          // ĐÓNG BĂNG nội dung sau khi có bất kỳ dấu duyệt nào (D hoặc H)
          "amount":  { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "empId":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "empName": { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "group":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "month":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists())) && (!newData.isString() || newData.val().length <= 20)" },
          "note":    { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          // SỐ DUYỆT / CHUYỂN: chỉ đúng vai trò được đặt/đổi; giữ nguyên thì ai ghi cũng qua (app ghi lại cả phiếu)
          "approvedD":   { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "approvedH":   { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "transferred": { ".validate": "(!newData.exists() || (data.exists() && newData.val() === data.val()) || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          // TRẠNG THÁI: đặt lần đầu ai cũng được; đổi về sau chỉ D/H/T
          "status": { ".validate": "!data.exists() || newData.val() === data.val() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')" }
        }
      },

      "groupChat": {
        // v113 CHAT NHÓM CÔNG TY: chỉ tài khoản ĐÃ DUYỆT đọc/gửi. Tin CHỈ THÊM MỚI hoặc XÓA
        // (không sửa): DŨNG xóa được mọi tin (kể cả xóa sạch cả nhóm — .write cấp cha);
        // người khác chỉ xóa tin CHÍNH MÌNH (so uid). User chốt 01/08.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$id": {
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (!data.exists() || (!newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('ts').isNumber() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 2000))"
        }
      },
      "chatPin": {
        // v116: TIN GHIM của nhóm chat (1 tin) — thành viên đã duyệt ghim/bỏ ghim
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        ".validate": "newData.child('k').isString() && newData.child('text').isString() && newData.child('text').val().length <= 300"
      },
      "chatRead": {
        // v109: mốc "đã đọc chat nhóm" của từng người (để đếm số tin chưa xem, đồng bộ đa thiết bị)
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      },

      // ═══ v125 P.KH: kho đề xuất RIÊNG phòng Kế hoạch — SAO CHÉP nguyên mọi lớp bảo vệ của proposals,
      // chỉ khác điều kiện vào cửa: đã duyệt VÀ (D/H/Trang HOẶC dept=kehoach/both). Kế toán thuần KHÔNG vào được.
      "khProposals": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được (chống người lạ tự đăng ký xem).
        ".read": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // Tạo/sửa: phải là tài khoản ĐÃ DUYỆT (v83 — tài khoản lạ/đã thu hồi không tạo/sửa phiếu được);
          // chi tiết bị siết thêm bằng validate từng trường bên dưới.
          // XÓA CẢ PHIẾU (newData không tồn tại): phiếu ĐÃ có duyệt → chỉ Dũng; phiếu chưa duyệt → tài khoản đã duyệt.
          ".write": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !(data.child('approvedD').exists() || data.child('approvedH').exists() || data.child('approvedDHistory').exists() || data.child('approvedHHistory').exists()))",

          // CHẶN GỠ DẤU DUYỆT / GỠ LỊCH SỬ (duyệt+chuyển) / GỠ ẢNH NỘI DUNG (v77 + v80):
          // - gỡ approvedD chỉ Dũng; gỡ approvedH chỉ Hiền (bỏ duyệt hợp lệ) — kẻ khác không thể "tự bỏ duyệt để mở khóa sửa"
          // - gỡ cả node transfers chỉ Trang; gỡ approvedDHistory chỉ Dũng, approvedHHistory chỉ Hiền (v80 —
          //   chống xóa/null lịch sử rồi lợi dụng approvedDAmount phụ để "backfill" số tiền giả)
          // - gỡ contentSnapshot (ảnh nội dung lúc duyệt) chỉ Dũng/Hiền
          ".validate": "(newData.child('approvedD').exists() || !data.child('approvedD').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedH').exists() || !data.child('approvedH').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('transfers').exists() || !data.child('transfers').exists() || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')) && (newData.child('approvedDHistory').exists() || !data.child('approvedDHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedHHistory').exists() || !data.child('approvedHHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('contentSnapshot').exists() || !data.child('contentSnapshot').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien')",

          // ĐÓNG BĂNG NỘI DUNG sau khi D HOẶC H đã duyệt (v77 — chống sửa số tài khoản/số tiền sau duyệt):
          // các trường dưới đây chỉ được GIỮ NGUYÊN một khi phiếu đã có bất kỳ dấu duyệt nào.
          // Muốn sửa thật: D/H bỏ duyệt trước (được phép theo luật trên) → sửa → duyệt lại.
          // v84: mỗi trường = (ĐÓNG BĂNG sau duyệt như cũ) && (GIỚI HẠN kích thước — chống tài khoản bị chiếm
          //      nhồi chữ rác / số tiền phi lý). Ngưỡng đặt RẤT RỘNG so với dữ liệu thật (desc dài nhất 158,
          //      note 179, amount lớn nhất ~859tr) nên KHÔNG thể chặn nhầm phiếu hợp lệ. Cap chỉ "cắn" đúng
          //      kiểu (isString/isNumber) — nếu không đúng kiểu thì không chặn (để lớp đóng băng lo).
          "desc":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          "note":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          // v95: lý do GẤP — trường tự do (không đóng băng), chỉ giới hạn độ dài chống nhồi rác
          "urgentReason": { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          "amount":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "amountUnit": { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 40)" },
          "person":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "site":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },

          // DẤU DUYỆT: thêm/đổi approvedD chỉ Dũng, approvedH chỉ Hiền (giữ nguyên thì ai ghi cũng được —
          // cần thiết vì app luôn ghi CẢ phiếu mỗi lần có gì đổi, các trường không đổi phải đi qua được)
          "approvedD": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedH": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // BẢN LƯU PHỤ số tiền duyệt (approvedDAmount/HAmount): đổi giá trị chỉ Dũng/Hiền (v80).
          // Trước đây 2 trường này KHÔNG bị khóa → kẻ xấu đặt số giả rồi để máy D/H "backfill" thành lịch sử.
          "approvedDAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedHAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // LỊCH SỬ DUYỆT (nguồn chuẩn số tiền): từng lần duyệt BẤT BIẾN sau khi ghi; THÊM lần mới chỉ đúng người
          "approvedDHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" } },
          "approvedHHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien')" } },

          // LỊCH SỬ CHUYỂN TIỀN: từng lần chuyển bất biến; thêm lần mới chỉ Trang
          "transfers": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val()) || (!data.exists() && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan'))" } },

          // TRẠNG THÁI: đặt lần đầu (tạo phiếu) ai cũng được; ĐỔI về sau chỉ Dũng/Hiền/Trang (chặn vai trò 'other' giả mạo "đã chuyển")
          "status": { ".validate": "!data.exists() || newData.val() === data.val() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan')" },

          // ẢNH NỘI DUNG LÚC DUYỆT (contentSnapshot — lớp phát hiện): từng trường chỉ Dũng/Hiền ghi/đổi
          "contentSnapshot": { "$f": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" } },

          // v106 HỎI–ĐÁP trên phiếu: từng câu nhắn BẤT BIẾN sau khi gửi (không sửa/xoá — user chốt);
          // thêm câu mới: bất kỳ tài khoản đã duyệt (đã gác ở .write), text ≤ 2000 ký tự.
          "chat": { "$i": { ".validate": "(data.exists() && newData.child('text').val() === data.child('text').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && newData.child('text').isString() && newData.child('text').val().length <= 2000)" } },
          // Dấu ĐÃ XEM hỏi–đáp của từng người (đồng bộ đa thiết bị): chỉ là mốc thời gian
          "chatSeen": { "$u": { ".validate": "newData.isNumber()" } }
        }
      },

      "khChat": {
        // v113 CHAT NHÓM CÔNG TY: chỉ tài khoản ĐÃ DUYỆT đọc/gửi. Tin CHỈ THÊM MỚI hoặc XÓA
        // (không sửa): DŨNG xóa được mọi tin (kể cả xóa sạch cả nhóm — .write cấp cha);
        // người khác chỉ xóa tin CHÍNH MÌNH (so uid). User chốt 01/08.
        ".read": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$id": {
          ".write": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com') && (!data.exists() || (!newData.exists() && data.child('uid').val() === auth.uid))",
          ".validate": "newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('ts').isNumber() && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 2000))"
        }
      },
      "khChatPin": {
        // v116: TIN GHIM của nhóm chat (1 tin) — thành viên đã duyệt ghim/bỏ ghim
        ".read": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        ".validate": "newData.child('k').isString() && newData.child('text').isString() && newData.child('text').val().length <= 300"
      },
      "khChatRead": {
        // v125: mốc "đã đọc" kênh chat Kế hoạch của từng người (đếm tin chưa xem, đồng bộ đa thiết bị)
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      },

      "khImages": {
        // v127 P.KH: ẢNH của phiếu P.Kế hoạch — cùng gate với khProposals (kế toán thuần không đọc được)
        ".read": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          ".write": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')"
        }
      },

      "pendingOtp": {
        // Gia Bình: Dũng đọc được CẢ nhánh để app hiện mã xác nhận trong Cài đặt → Duyệt tài khoản
        ".read": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$uid": {
          // Chỉ chính mình hoặc Dũng đọc/xóa OTP
          ".read": "auth != null && (auth.uid === $uid || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          ".write": "auth != null && (auth.uid === $uid || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          "otp":    { ".validate": "newData.isString() && newData.val().length <= 10" },
          "name":   { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ts":     { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      "online": {
        ".read": "auth != null",
        "$uid": {
          // Chỉ chính mình ghi trạng thái online của mình
          ".write": "auth != null && auth.uid === $uid",
          "name":     { ".validate": "newData.isString() && newData.val().length <= 200" },
          "role":     { ".validate": "newData.isString() && newData.val().length <= 20" },
          "since":    { ".validate": "newData.isNumber()" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other":   { ".validate": false }
        }
      }
    },

    // Gia Bình KHÔNG dùng 2 nhánh này nữa: thông báo đẩy đi qua trạm gbRelay (đăng ký + hàng đợi nằm ở
    // máy chủ 379, client không chạm tới). Đóng hẳn để không còn là bề mặt tấn công.
    "push-subs":  { ".read": false, ".write": false },
    "push-queue": { ".read": false, ".write": false }
  }
}
