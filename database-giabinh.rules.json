vedHHistory/10').exists()) && (newData.child('approvedHHistory/11').exists() || !data.child('approvedHHistory/11').exists()) && (newData.child('approvedHHistory/12').exists() || !data.child('approvedHHistory/12').exists()) && (newData.child('approvedHHistory/13').exists() || !data.child('approvedHHistory/13').exists()) && (newData.child('approvedHHistory/14').exists() || !data.child('approvedHHistory/14').exists()) && (newData.child('approvedHHistory/15').exists() || !data.child('approvedHHistory/15').exists()) && (newData.child('approvedHHistory/16').exists() || !data.child('approvedHHistory/16').exists()) && (newData.child('approvedHHistory/17').exists() || !data.child('approvedHHistory/17').exists()) && (newData.child('approvedHHistory/18').exists() || !data.child('approvedHHistory/18').exists()) && (newData.child('approvedHHistory/19').exists() || !data.child('approvedHHistory/19').exists())))",

          // ĐÓNG BĂNG NỘI DUNG sau khi D HOẶC H đã duyệt (v77 — chống sửa số tài khoản/số tiền sau duyệt):
