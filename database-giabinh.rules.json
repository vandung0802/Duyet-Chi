{
  // ══ LUẬT BẢO MẬT — App SỔ QUỸ GIA BÌNH (project so-quy-gia-binh) ══
  // Bê nguyên từ app 379 để không sót lỗ hổng nào đã vá. Khác 379 ở chỗ:
  //  - ĐỘI ĐỎ 22/09/2026: ĐÃ GỠ email Hiền/Trang khỏi mọi luật. Ở project này 2 email đó CHƯA đăng ký
  //    (Firebase không bắt chứng minh sở hữu hộp thư) → người lạ đăng ký trước là tự có vai 'hien'/'trang',
  //    đọc hết sổ và giả được duyệt bước 2. Nay CHỈ email Dũng (chắc chắn đã đăng ký) là lối vào dự phòng;
  //    mọi người khác — kể cả Hiền, Trang — phải được Dũng bấm 'Cho xem' + cấp vai trong Cài đặt.
  //  - Lan (đại diện cty 134) duyệt NGANG Hiền → dùng chung vai 'hien'. Email Lan CHƯA có,
  //    nên Lan KHÔNG được ghi sẵn vào đây; D vào app cấp vai 'hien' cho Lan là chạy
  //    (3 email ghi cứng bên dưới chỉ là lối vào dự phòng lúc app chưa có ai duyệt tài khoản).
  //  - TẤT CẢ người đã duyệt đều xem được mọi phiếu (D chốt: ai có trong app là thấy hết).
  //  - Phần P.Kế hoạch (khProposals/khImages…) giữ lại để file không lệch với 379,
  //    nhưng app Gia Bình tắt tab đó nên không ai ghi vào.
  "rules": {

    "duyetchi": {
      // v79 BẢO MẬT: KHÔNG đặt ".read" ở cấp cha này. Trong Firebase RTDB, ".read" ở cha LAN XUỐNG mọi
      // con và con KHÔNG thu hồi được — nếu để ".read: auth != null" ở đây thì pendingOtp (mã OTP) sẽ bị
      // MỌI tài khoản đọc được, vô hiệu hoá luật đọc-hạn-chế của nó. Vì vậy quyền đọc được khai riêng ở
      // TỪNG nhánh con bên dưới (proposals/images/plans/meta/userRoles/online đều cho người đăng nhập đọc;
      // riêng pendingOtp chỉ chính chủ hoặc Dũng đọc).

      "userRoles": {
        // v81: Dũng đọc được CẢ node (để hiện danh sách "duyệt tài khoản"). Người khác chỉ đọc bản thân (ở $uid).
        ".read": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$uid": {
          // VÒNG 2: trước đây "auth != null" → người lạ vừa tự đăng ký đọc được tên/email/phòng/lần đăng nhập của MỌI nhân viên
          ".read": "auth != null && auth.uid === $uid",
          // CHẶN LEO QUYỀN (v77): tự ghi role của MÌNH chỉ được 'other' — TRỪ 3 người nhà xác thực
          // bằng ĐÚNG EMAIL đăng nhập (không thể giả). Dũng ghi được cho bất kỳ ai.
          // v81/v82: TỰ ghi được hồ sơ của mình (tên/email/lastLogin) nhưng KHÔNG được TỰ ĐỔI cờ approved
          // (phải giữ nguyên như cũ) — chống tự cấp quyền xem. Chỉ Dũng mới đặt/đổi approved.
          // v125 P.KH: trường dept (phòng: ketoan/kehoach/both) cũng KHÓA như approved — chỉ Dũng đổi được,
          // chống người P.Kế hoạch tự đổi mình thành Kế toán để vượt rào đọc dữ liệu (bước 5).
          ".write": "auth != null && ((auth.uid === $uid && newData.child('approved').val() === data.child('approved').val() && newData.child('dept').val() === data.child('dept').val() && (newData.child('role').val() === 'other' || (newData.child('role').val() === 'dung' && auth.token.email === 'vandung0802@gmail.com') || (data.exists() && newData.child('role').val() === data.child('role').val()))) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          // ── ĐỘI ĐỎ 22/09/2026: DANH SÁCH TRẮNG + GIỚI HẠN CỠ cho hồ sơ ──
          // Trước đây hồ sơ (do chính người dùng ghi) không giới hạn gì: người lạ tự đăng ký nhồi được hàng trăm MB
          // → làm treo trang "Duyệt tài khoản" của Dũng, đốt băng thông. Đúng 6 trường app thật sự ghi:
          "role":      { ".validate": "newData.isString() && newData.val().length <= 20" },
          "name":      { ".validate": "newData.isString() && newData.val().length <= 200" },
          // email trong hồ sơ PHẢI đúng là email đăng nhập thật (Google xác thực). Trước đây tự ghi tuỳ ý →
          // người lạ ghi email của 1 nhân viên quen để danh sách duyệt KHÔNG báo đỏ "email lạ", lừa Dũng bấm duyệt.
          "email":     { ".validate": "newData.isString() && newData.val().length <= 320 && (newData.val() === auth.token.email || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" },
          "lastLogin": { ".validate": "newData.isNumber()" },
          // VÒNG 2: email đăng nhập KHÔNG chứng minh người đó sở hữu hộp thư (Firebase không bắt xác minh) →
          // app gửi thư xác minh lúc đăng ký; cờ ev chỉ thành true khi TOKEN nói đã xác minh (không tự khai được).
          "ev":        { ".validate": "newData.isBoolean() && (newData.val() === false || auth.token.email_verified === true)" },
          "approved":  { ".validate": "newData.isBoolean()" },
          "dept":      { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other":    { ".validate": false }
        }
      },

      "meta": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT (approved) hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        // Chỉ Dũng mới sửa được danh sách người/công trình
        ".write": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'"
      },

      "proposals": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được (chống người lạ tự đăng ký xem).
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // Tạo/sửa: phải là tài khoản ĐÃ DUYỆT (v83 — tài khoản lạ/đã thu hồi không tạo/sửa phiếu được);
          // chi tiết bị siết thêm bằng validate từng trường bên dưới.
          // XÓA CẢ PHIẾU (newData không tồn tại): phiếu ĐÃ có duyệt → chỉ Dũng; phiếu chưa duyệt → tài khoản đã duyệt.
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !(data.child('approvedD').exists() || data.child('approvedH').exists() || data.child('approvedDHistory').exists() || data.child('approvedHHistory').exists()))",

          // CHẶN GỠ DẤU DUYỆT / GỠ LỊCH SỬ (duyệt+chuyển) / GỠ ẢNH NỘI DUNG (v77 + v80):
          // - gỡ approvedD chỉ Dũng; gỡ approvedH chỉ Hiền (bỏ duyệt hợp lệ) — kẻ khác không thể "tự bỏ duyệt để mở khóa sửa"
          // - gỡ cả node transfers chỉ TOÀN (thủ quỹ; vòng 2 đã gỡ vai 'trang' — ở Gia Bình Trang chỉ đề xuất vật tư); gỡ approvedDHistory chỉ Dũng, approvedHHistory chỉ Hiền (v80 —
          //   chống xóa/null lịch sử rồi lợi dụng approvedDAmount phụ để "backfill" số tiền giả)
          // - gỡ contentSnapshot (ảnh nội dung lúc duyệt) chỉ Dũng/Hiền
          // ── VÒNG 2 (22/09/2026): XOÁ LẺ TỪNG LẦN chuyển/duyệt ──
          // .validate KHÔNG chạy khi xoá → luật "từng lần bất biến" ở transfers/$i không cản được việc XOÁ 1 lần.
          // Phiếu chuyển 2 lần, kẻ xấu (hoặc 1 máy đang giữ dữ liệu CŨ ghi đè cả phiếu) xoá lần 2 → app báo
          // "còn phải chuyển" → thủ quỹ chuyển TRÙNG. Nay .validate cấp phiếu bên dưới buộc: mục nào ĐÃ CÓ
          // (chỉ số 0..19) thì PHẢI CÒN, trừ đúng vai được hoàn tác (thủ quỹ / Dũng / Hiền — khớp nút trong app).
          ".validate": "(newData.child('approvedD').exists() || !data.child('approvedD').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedH').exists() || !data.child('approvedH').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('transfers').exists() || !data.child('transfers').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') && (newData.child('approvedDHistory').exists() || !data.child('approvedDHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung') && (newData.child('approvedHHistory').exists() || !data.child('approvedHHistory').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (newData.child('contentSnapshot').exists() || !data.child('contentSnapshot').exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien') && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan' || ((newData.child('transfers/0').exists() || !data.child('transfers/0').exists()) && (newData.child('transfers/1').exists() || !data.child('transfers/1').exists()) && (newData.child('transfers/2').exists() || !data.child('transfers/2').exists()) && (newData.child('transfers/3').exists() || !data.child('transfers/3').exists()) && (newData.child('transfers/4').exists() || !data.child('transfers/4').exists()) && (newData.child('transfers/5').exists() || !data.child('transfers/5').exists()) && (newData.child('transfers/6').exists() || !data.child('transfers/6').exists()) && (newData.child('transfers/7').exists() || !data.child('transfers/7').exists()) && (newData.child('transfers/8').exists() || !data.child('transfers/8').exists()) && (newData.child('transfers/9').exists() || !data.child('transfers/9').exists()) && (newData.child('transfers/10').exists() || !data.child('transfers/10').exists()) && (newData.child('transfers/11').exists() || !data.child('transfers/11').exists()) && (newData.child('transfers/12').exists() || !data.child('transfers/12').exists()) && (newData.child('transfers/13').exists() || !data.child('transfers/13').exists()) && (newData.child('transfers/14').exists() || !data.child('transfers/14').exists()) && (newData.child('transfers/15').exists() || !data.child('transfers/15').exists()) && (newData.child('transfers/16').exists() || !data.child('transfers/16').exists()) && (newData.child('transfers/17').exists() || !data.child('transfers/17').exists()) && (newData.child('transfers/18').exists() || !data.child('transfers/18').exists()) && (newData.child('transfers/19').exists() || !data.child('transfers/19').exists()))) && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || ((newData.child('approvedDHistory/0').exists() || !data.child('approvedDHistory/0').exists()) && (newData.child('approvedDHistory/1').exists() || !data.child('approvedDHistory/1').exists()) && (newData.child('approvedDHistory/2').exists() || !data.child('approvedDHistory/2').exists()) && (newData.child('approvedDHistory/3').exists() || !data.child('approvedDHistory/3').exists()) && (newData.child('approvedDHistory/4').exists() || !data.child('approvedDHistory/4').exists()) && (newData.child('approvedDHistory/5').exists() || !data.child('approvedDHistory/5').exists()) && (newData.child('approvedDHistory/6').exists() || !data.child('approvedDHistory/6').exists()) && (newData.child('approvedDHistory/7').exists() || !data.child('approvedDHistory/7').exists()) && (newData.child('approvedDHistory/8').exists() || !data.child('approvedDHistory/8').exists()) && (newData.child('approvedDHistory/9').exists() || !data.child('approvedDHistory/9').exists()) && (newData.child('approvedDHistory/10').exists() || !data.child('approvedDHistory/10').exists()) && (newData.child('approvedDHistory/11').exists() || !data.child('approvedDHistory/11').exists()) && (newData.child('approvedDHistory/12').exists() || !data.child('approvedDHistory/12').exists()) && (newData.child('approvedDHistory/13').exists() || !data.child('approvedDHistory/13').exists()) && (newData.child('approvedDHistory/14').exists() || !data.child('approvedDHistory/14').exists()) && (newData.child('approvedDHistory/15').exists() || !data.child('approvedDHistory/15').exists()) && (newData.child('approvedDHistory/16').exists() || !data.child('approvedDHistory/16').exists()) && (newData.child('approvedDHistory/17').exists() || !data.child('approvedDHistory/17').exists()) && (newData.child('approvedDHistory/18').exists() || !data.child('approvedDHistory/18').exists()) && (newData.child('approvedDHistory/19').exists() || !data.child('approvedDHistory/19').exists()))) && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || ((newData.child('approvedHHistory/0').exists() || !data.child('approvedHHistory/0').exists()) && (newData.child('approvedHHistory/1').exists() || !data.child('approvedHHistory/1').exists()) && (newData.child('approvedHHistory/2').exists() || !data.child('approvedHHistory/2').exists()) && (newData.child('approvedHHistory/3').exists() || !data.child('approvedHHistory/3').exists()) && (newData.child('approvedHHistory/4').exists() || !data.child('approvedHHistory/4').exists()) && (newData.child('approvedHHistory/5').exists() || !data.child('approvedHHistory/5').exists()) && (newData.child('approvedHHistory/6').exists() || !data.child('approvedHHistory/6').exists()) && (newData.child('approvedHHistory/7').exists() || !data.child('approvedHHistory/7').exists()) && (newData.child('approvedHHistory/8').exists() || !data.child('approvedHHistory/8').exists()) && (newData.child('approvedHHistory/9').exists() || !data.child('approvedHHistory/9').exists()) && (newData.child('approvedHHistory/10').exists() || !data.child('approvedHHistory/10').exists()) && (newData.child('approvedHHistory/11').exists() || !data.child('approvedHHistory/11').exists()) && (newData.child('approvedHHistory/12').exists() || !data.child('approvedHHistory/12').exists()) && (newData.child('approvedHHistory/13').exists() || !data.child('approvedHHistory/13').exists()) && (newData.child('approvedHHistory/14').exists() || !data.child('approvedHHistory/14').exists()) && (newData.child('approvedHHistory/15').exists() || !data.child('approvedHHistory/15').exists()) && (newData.child('approvedHHistory/16').exists() || !data.child('approvedHHistory/16').exists()) && (newData.child('approvedHHistory/17').exists() || !data.child('approvedHHistory/17').exists()) && (newData.child('approvedHHistory/18').exists() || !data.child('approvedHHistory/18').exists()) && (newData.child('approvedHHistory/19').exists() || !data.child('approvedHHistory/19').exists())))",

          // ĐÓNG BĂNG NỘI DUNG sau khi D HOẶC H đã duyệt (v77 — chống sửa số tài khoản/số tiền sau duyệt):
          // các trường dưới đây chỉ được GIỮ NGUYÊN một khi phiếu đã có bất kỳ dấu duyệt nào.
          // Muốn sửa thật: D/H bỏ duyệt trước (được phép theo luật trên) → sửa → duyệt lại.
          // v84: mỗi trường = (ĐÓNG BĂNG sau duyệt như cũ) && (GIỚI HẠN kích thước — chống tài khoản bị chiếm
          //      nhồi chữ rác / số tiền phi lý). Ngưỡng đặt RẤT RỘNG so với dữ liệu thật (desc dài nhất 158,
          //      note 179, amount lớn nhất ~859tr) nên KHÔNG thể chặn nhầm phiếu hợp lệ. Cap chỉ "cắn" đúng
          //      kiểu (isString/isNumber) — nếu không đúng kiểu thì không chặn (để lớp đóng băng lo).
          // VÒNG 2: 'kind' (loại phiếu: thường/lương) đóng băng sau duyệt — đổi kind là phiếu BIẾN MẤT khỏi danh sách và khỏi "đã chi".
          "kind": { ".validate": "newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())" },
          "desc":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          "note":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 5000)" },
          // v95: lý do GẤP — trường tự do (không đóng băng), chỉ giới hạn độ dài chống nhồi rác
          "urgentReason": { ".validate": "!newData.isString() || newData.val().length <= 2000" },
          "amount":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isNumber() || (newData.val() >= 0 && newData.val() <= 100000000000))" },
          "amountUnit": { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 40)" },
          "person":     { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          "site":       { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 200)" },
          // Gia Bình: LOẠI CHI PHÍ cũng đóng băng sau duyệt — đổi ký quỹ ↔ chi phí lúc đã duyệt/chuyển sẽ làm lệch sổ quỹ
          "costType":   { ".validate": "(newData.val() === data.val() || !(data.parent().child('approvedD').exists() || data.parent().child('approvedH').exists() || data.parent().child('approvedDHistory').exists() || data.parent().child('approvedHHistory').exists())) && (!newData.isString() || newData.val().length <= 20)" },

          // DẤU DUYỆT: thêm/đổi approvedD chỉ Dũng, approvedH chỉ Hiền (giữ nguyên thì ai ghi cũng được —
          // cần thiết vì app luôn ghi CẢ phiếu mỗi lần có gì đổi, các trường không đổi phải đi qua được)
          "approvedD": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedH": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // BẢN LƯU PHỤ số tiền duyệt (approvedDAmount/HAmount): đổi giá trị chỉ Dũng/Hiền (v80).
          // Trước đây 2 trường này KHÔNG bị khóa → kẻ xấu đặt số giả rồi để máy D/H "backfill" thành lịch sử.
          "approvedDAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'" },
          "approvedHAmount": { ".validate": "(data.exists() && newData.val() === data.val()) || !newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" },

          // LỊCH SỬ DUYỆT (nguồn chuẩn số tiền): từng lần duyệt BẤT BIẾN sau khi ghi; THÊM lần mới chỉ đúng người
          "approvedDHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" } },
          "approvedHHistory": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien')" } },

          // LỊCH SỬ CHUYỂN TIỀN: từng lần chuyển bất biến; thêm lần mới chỉ THỦ QUỸ và CHỈ KHI đã có
          // bước duyệt 2 (Hiền/Lan) — quy trình Gia Bình: Dũng → Hiền/Lan → Toàn, không chuyển tắt.
          "transfers": { "$i": { ".validate": "(data.exists() && newData.child('amount').val() === data.child('amount').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan' && newData.parent().parent().child('approvedHHistory').exists())" } },

          // TRẠNG THÁI: đặt lần đầu (tạo phiếu) ai cũng được; ĐỔI về sau chỉ Dũng/Hiền/Trang (chặn vai trò 'other' giả mạo "đã chuyển")
          "status": { ".validate": "!data.exists() || newData.val() === data.val() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan'" },

          // ẢNH NỘI DUNG LÚC DUYỆT (contentSnapshot — lớp phát hiện): từng trường chỉ Dũng/Hiền ghi/đổi
          "contentSnapshot": { "$f": { ".validate": "(data.exists() && newData.val() === data.val()) || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien'" } },

          // v106 HỎI–ĐÁP trên phiếu: từng câu nhắn BẤT BIẾN sau khi gửi (không sửa/xoá — user chốt);
          // thêm câu mới: bất kỳ tài khoản đã duyệt (đã gác ở .write), text ≤ 2000 ký tự.
          "chat": { "$i": { ".validate": "(data.exists() && newData.child('text').val() === data.child('text').val() && newData.child('ts').val() === data.child('ts').val() && newData.child('by').val() === data.child('by').val()) || (!data.exists() && newData.child('text').isString() && newData.child('text').val().length <= 2000)" } },
          // Dấu ĐÃ XEM hỏi–đáp của từng người (đồng bộ đa thiết bị): chỉ là mốc thời gian
          "chatSeen": { "$u": { ".validate": "newData.isNumber()" } }
        }
      },

      "images": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // v83: GHI cũng phải là tài khoản ĐÃ DUYỆT (tài khoản lạ / đã bị thu hồi không ghi/xoá ảnh được).
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() !== 'kehoach' || auth.token.email === 'vandung0802@gmail.com')"
        }
      },

      // ══ bankBalance — số dư ngân hàng THẬT do thủ quỹ nhập để đối chiếu với sổ quỹ ══
      // Để riêng (không nằm trong meta) vì meta chỉ Dũng ghi được, mà người nhập số này là thủ quỹ.
      "bankBalance": {
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        ".validate": "!newData.exists() || (newData.child('amount').isNumber() && newData.child('amount').val() >= 0)"
      },

      // ══ cashflow — THU + KÝ QUỸ của Gia Bình (app 379 không có nhánh này) ══
      // Ai đã được duyệt đều GHI/SỬA được (sổ quỹ chung, không có luồng duyệt nhiều bước).
      // XÓA thì chỉ Dũng hoặc chính người đã ghi khoản đó — tiền chung 2 công ty, không để ai cũng xóa được.
      "cashflow": {
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          // KHÔNG đặt .validate ở đây: ghi cọc lấy về chỉ đụng $id/returned (không có
          // type/amount) — validate của cha vẫn chạy khi ghi con nên sẽ chặn nhầm.
          // ── XOÁ KHOẢN (v25, D chốt 22/09/2026): "mọi nút xoá trong Cân đối phải được D, H, L đồng ý; riêng D xoá thẳng" ──
          //  • Dũng (quản trị): xoá thẳng.
          //  • Hiền / Lan: chỉ xoá được khi đề nghị xoá đã có ĐỦ 3 phiếu đồng ý ở deleteReq/ok: dung + hien1 + hien2
          //    (hien1 ≠ hien2 = hai tài khoản vai H&L khác nhau, tức Hiền VÀ Lan).
          //  • Toàn: chỉ được gỡ khoản ký quỹ TỰ SINH từ phiếu chi (id p_<phiếu>_<lần>) khi lần chuyển tương ứng
          //    (transfers/<tn>) đã KHÔNG còn trên phiếu — tức đang hoàn tác chuyển tiền; không gỡ được khoản còn gắn tiền thật.
          //  • Người khác (kể cả người đã ghi khoản đó): KHÔNG xoá được — chỉ ghi được đề nghị xoá (deleteReq).
          ".write": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com') && (newData.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' && data.child('deleteReq/ok/dung').exists() && data.child('deleteReq/ok/hien1').exists() && data.child('deleteReq/ok/hien2').exists()) || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan' && $id.beginsWith('p_') && data.child('fromProposal').isString() && data.child('tn').isString() && !root.child('duyetchi/proposals').child(data.child('fromProposal').val()).child('transfers').child(data.child('tn').val()).exists()))",
          // VÒNG 2: người ghi ('by') bất biến; tạo mới phải = chính mình.
          "by": { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid)" },
          // v25: NỘI DUNG khoản đóng băng sau khi ghi (chỉ Dũng sửa) — nếu không, "xoá phải 3 người duyệt" bị lách
          // bằng cách sửa số tiền về 0. App không có màn sửa khoản nên không chặn nhầm gì.
          // v40: khoản 'ret' (trả lại vốn góp) chỉ THỦ QUỸ (toan) hoặc Dũng tạo được — D chốt 24/09/2026.
          "type":         { ".validate": "(root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()) && (newData.val() !== 'ret' || data.exists() || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" },
          "amount":       { ".validate": "(root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000" },
          "desc":         { ".validate": "(root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()) && (!newData.isString() || newData.val().length <= 2000)" },
          "date":         { ".validate": "root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()" },
          "src":          { ".validate": "root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()" },
          "holder":       { ".validate": "root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()" },
          "fromProposal": { ".validate": "root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()" },
          "tn":           { ".validate": "(root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()) && newData.isString() && newData.val().length <= 4" },
          "byName":       { ".validate": "root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || !data.exists() || newData.val() === data.val()" },
          // ĐỀ NGHỊ XOÁ: ai đã duyệt cũng gửi được; từng phiếu đồng ý = uid của CHÍNH người bấm, đúng vai, ghi rồi không đổi.
          // (Xoá phiếu đồng ý / huỷ đề nghị thì luật không cản — chỉ làm CHẬM việc xoá, không làm mất tiền.)
          "deleteReq": {
            "by":     { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid)" },
            "byName": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "ts":     { ".validate": "newData.isNumber()" },
            "names":  { "$u": { ".validate": "newData.isString() && newData.val().length <= 200" } },
            "ok": {
              "dung":  { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')" },
              "hien1": { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' && newData.val() !== newData.parent().child('hien2').val())" },
              "hien2": { ".validate": "(data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === auth.uid && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' && newData.val() !== newData.parent().child('hien1').val())" },
              "$o":    { ".validate": false }
            },
            "$o": { ".validate": false }
          }
        }
      },

      "plans": {
        // v81: chỉ tài khoản ĐÃ ĐƯỢC DUYỆT hoặc 3 email người nhà mới đọc được.
        ".read": "auth != null && (root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
