      },

      "khImages": {
        // v127 P.KH: ẢNH của phiếu P.Kế hoạch — cùng gate với khProposals (kế toán thuần không đọc được)
        ".read": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')",
        "$id": {
          ".write": "auth != null && ((root.child('duyetchi/userRoles').child(auth.uid).child('approved').val() === true && (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'hien' || (root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'trang' || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'toan') || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'kehoach' || root.child('duyetchi/userRoles').child(auth.uid).child('dept').val() === 'both')) || auth.token.email === 'vandung0802@gmail.com')"
        }
      },

      "pendingOtp": {
        // Gia Bình: Dũng đọc được CẢ nhánh để app hiện mã xác nhận trong Cài đặt → Duyệt tài khoản
        ".read": "auth != null && root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung'",
        "$uid": {
          // Chỉ chính mình hoặc Dũng đọc/xóa OTP
          ".read": "auth != null && (auth.uid === $uid || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          ".write": "auth != null && (auth.uid === $uid || root.child('duyetchi/userRoles').child(auth.uid).child('role').val() === 'dung')",
          "otp":    { ".validate": "newData.isString() && newData.val().length <= 10" },
          "name":   { ".validate": "newData.isString() && newData.val().length <= 200" },
          "ts":     { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      "online": {
        ".read": "auth != null",
        "$uid": {
          // Chỉ chính mình ghi trạng thái online của mình
          ".write": "auth != null && auth.uid === $uid",
          "name":     { ".validate": "newData.isString() && newData.val().length <= 200" },
          "role":     { ".validate": "newData.isString() && newData.val().length <= 20" },
          "since":    { ".validate": "newData.isNumber()" },
          "lastSeen": { ".validate": "newData.isNumber()" },
          "$other":   { ".validate": false }
        }
      }
    },

    // Gia Bình KHÔNG dùng 2 nhánh này nữa: thông báo đẩy đi qua trạm gbRelay (đăng ký + hàng đợi nằm ở
    // máy chủ 379, client không chạm tới). Đóng hẳn để không còn là bề mặt tấn công.
    "push-subs":  { ".read": false, ".write": false },
    "push-queue": { ".read": false, ".write": false }
  }
}
